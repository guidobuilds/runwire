{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": false,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun-types"],
    "paths": {
      "@runwire/core": ["./packages/core/src/index.ts"],
      "@runwire/core/test-kit": ["./packages/core/src/test-kit/index.ts"],
      "@runwire/adapter-claude-code": ["./packages/adapter-claude-code/src/index.ts"],
      "@runwire/adapter-opencode": ["./packages/adapter-opencode/src/index.ts"],
      "@runwire/adapter-pi": ["./packages/adapter-pi/src/index.ts"],
      "@runwire/server": ["./packages/server/src/index.ts"],
      "@/*": ["./packages/web/src/*"]
    }
  }
}
