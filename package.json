{
  "name": "scout-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "lint": "biome check . && bun run boundaries",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "scout": "bun packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "bun-types": "1.4.0",
    "dependency-cruiser": "18.2.0",
    "typescript": "6.0.3"
  }
}
