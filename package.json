{
  "name": "runwire-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, read-only explorer of coding-agent sessions: token and time waste, without prompts or code.",
  "license": "MIT",
  "homepage": "https://github.com/guidobuilds/runwire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidobuilds/runwire.git"
  },
  "bugs": {
    "url": "https://github.com/guidobuilds/runwire/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "lint": "biome check . && bun run boundaries",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "runwire": "bun packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "bun-types": "1.4.0",
    "dependency-cruiser": "18.2.0",
    "typescript": "6.0.3"
  }
}
